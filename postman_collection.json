{
  "info": {
    "name": "Notes REST API - Assignment 03",
    "description": "Postman Collection for testing the Assignment 03 Notes REST API. Set up the collection variable `base_url` to `http://localhost:5000/api/notes`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/notes",
      "type": "string"
    },
    {
      "key": "note_id",
      "value": "64b1f2c3e4d5a6b7c8d9e0f1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. CRUD",
      "item": [
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Team standup agenda\",\n  \"content\": \"Discuss sprint blockers and deployment plan\",\n  \"category\": \"work\",\n  \"isPinned\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            }
          }
        },
        {
          "name": "Create Bulk Notes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": [\n    { \"title\": \"Note one\",   \"content\": \"Content one\",   \"category\": \"work\"     },\n    { \"title\": \"Note two\",   \"content\": \"Content two\",   \"category\": \"study\"    },\n    { \"title\": \"Note three\", \"content\": \"Content three\", \"category\": \"personal\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/bulk",
              "host": ["{{base_url}}"],
              "path": ["bulk"]
            }
          }
        },
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            }
          }
        },
        {
          "name": "Get Note by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{note_id}}"]
            }
          }
        },
        {
          "name": "Full Replace Note (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Completely new title\",\n  \"content\": \"Completely new content\",\n  \"category\": \"personal\",\n  \"isPinned\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{note_id}}"]
            }
          }
        },
        {
          "name": "Partial Update Note (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPinned\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{note_id}}"]
            }
          }
        },
        {
          "name": "Delete Note by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{note_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{note_id}}"]
            }
          }
        },
        {
          "name": "Delete Bulk Notes",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"64b1f2c3e4d5a6b7c8d9e0f1\",\n    \"64b1f2c3e4d5a6b7c8d9e0f2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/bulk",
              "host": ["{{base_url}}"],
              "path": ["bulk"]
            }
          }
        }
      ]
    },
    {
